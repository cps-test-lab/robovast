[MESSAGES CONTROL]
max-line-length=140
# redefined-outer-name and protected-access are pytest, not defects: a test takes its
# fixture as an argument named after the fixture function, and a unit test reaches into
# the internals of the unit it is testing. Between them they accounted for 1128 of the
# 1338 findings on the v2 tree, 1125 of those under tests/, so leaving them on meant the
# real findings were unreadable underneath -- and the alternative is renaming every
# fixture argument in the suite to fight the idiom.
# relative-beyond-top-level: `robovast/` and `robovast/execution/` carry no __init__.py on
# purpose -- they are PEP 420 namespace packages so the robovast and robovast-cluster trees
# merge into one import path (see src/robovast_cluster/pyproject.toml). pylint cannot
# compute a package depth without __init__.py, so every `from ..x import y` across the
# split reads as an escape from the package. The imports resolve fine at runtime.
# Four codes that describe a pytest suite rather than a defect. Each was checked against
# the tree first: all four have ZERO occurrences in src/, so nothing in the shipped code
# stops being linted by turning them off.
#  use-implicit-booleaness-not-comparison (57x): `assert rows == []` asserts an empty
#    *list*; the suggested `assert not rows` also passes for None, 0 and "". Rewriting
#    all 57 would weaken the assertions it touched.
#  abstract-method (23x): a test double implements the methods its test exercises and
#    inherits the rest -- see _FakeStorage, which inherits StorageClient precisely to run
#    the real count_pending. Satisfying pylint means stubbing methods nothing calls.
#  unbalanced-tuple-unpacking (19x): pylint reads the arity off the `records: List = []`
#    literal at the top of a function that appends in a loop, and concludes every return
#    has 0 values. `(rec,) = parse_container_log(...)` is correct and passes.
#  unnecessary-lambda (29x): `lambda: object()` is not interchangeable with `object` when
#    monkeypatch installs it -- one patches in a function, the other a class.
disable=use-implicit-booleaness-not-comparison,abstract-method,unbalanced-tuple-unpacking,unnecessary-lambda,relative-beyond-top-level,redefined-outer-name,protected-access,too-many-positional-arguments,attribute-defined-outside-init,no-self-use,anomalous-backslash-in-string,too-many-arguments,too-few-public-methods,too-many-instance-attributes,redefined-variable-type,unused-argument,bad-continuation,too-many-lines,too-many-branches,locally-disabled,too-many-locals,too-many-statements,duplicate-code,too-many-nested-blocks,fixme,useless-object-inheritance,no-else-raise,no-else-break,unnecessary-pass,no-else-return,super-with-arguments,no-else-continue,bad-option-value,consider-using-dict-items,consider-using-f-string,line-too-long,wrong-import-order,missing-function-docstring,missing-class-docstring,f-string-without-interpolation,import-error,missing-module-docstring,consider-using-with,unspecified-encoding,no-name-in-module,too-many-public-methods,broad-exception-caught,trailing-whitespace,logging-format-interpolation,logging-fstring-interpolation,import-outside-toplevel,cyclic-import,too-many-return-statements
# numpy: pylint resolves numpy's C extensions by inference and gets it wrong -- it reports
# numpy.random.RandomState, which exists, as a missing member.
ignored-modules=numpy,geometry_msgs,py_trees,launch,PySide6,PySide6.QtCore,PySide6.QtGui,PySide6.QtWidgets,PySide6.QtWebEngineWidgets
variable-rgx=[a-z0-9_]{1,40}$
# Allow long, descriptive test function names (test_..._...).
function-rgx=[a-z0-9_]{1,80}$
# Allow Qt method names (camelCase for Qt overrides)
method-rgx=([a-z_][a-z0-9_]{2,40}|[a-z][a-zA-Z0-9]{2,40})$