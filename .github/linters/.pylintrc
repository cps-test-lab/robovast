[MESSAGES CONTROL]
max-line-length=140
# redefined-outer-name and protected-access are pytest, not defects: a test takes its
# fixture as an argument named after the fixture function, and a unit test reaches into
# the internals of the unit it is testing. Between them they accounted for 1128 of the
# 1338 findings on the v2 tree, 1125 of those under tests/, so leaving them on meant the
# real findings were unreadable underneath -- and the alternative is renaming every
# fixture argument in the suite to fight the idiom.
disable=redefined-outer-name,protected-access,too-many-positional-arguments,attribute-defined-outside-init,no-self-use,anomalous-backslash-in-string,too-many-arguments,too-few-public-methods,too-many-instance-attributes,redefined-variable-type,unused-argument,bad-continuation,too-many-lines,too-many-branches,locally-disabled,too-many-locals,too-many-statements,duplicate-code,too-many-nested-blocks,fixme,useless-object-inheritance,no-else-raise,no-else-break,unnecessary-pass,no-else-return,super-with-arguments,no-else-continue,bad-option-value,consider-using-dict-items,consider-using-f-string,line-too-long,wrong-import-order,missing-function-docstring,missing-class-docstring,f-string-without-interpolation,import-error,missing-module-docstring,consider-using-with,unspecified-encoding,no-name-in-module,too-many-public-methods,broad-exception-caught,trailing-whitespace,logging-format-interpolation,logging-fstring-interpolation,import-outside-toplevel,cyclic-import,too-many-return-statements
ignored-modules=geometry_msgs,py_trees,launch,PySide6,PySide6.QtCore,PySide6.QtGui,PySide6.QtWidgets,PySide6.QtWebEngineWidgets
variable-rgx=[a-z0-9_]{1,40}$
# Allow long, descriptive test function names (test_..._...).
function-rgx=[a-z0-9_]{1,80}$
# Allow Qt method names (camelCase for Qt overrides)
method-rgx=([a-z_][a-z0-9_]{2,40}|[a-z][a-zA-Z0-9]{2,40})$