# syntax=docker/dockerfile:1
#
# robovast + roqsim: the ``robovast-roqsim`` family member, and the image for **both**
# roqsim shapes.
#
#   stepped (mode: base)  a SimulationInterface is stepped in-process by
#                         scenario-execution, so simulator and scenario share a process
#                         and therefore an image.
#   ROS (mode: ros2)      the simulator runs in a container of its own -- from this image
#                         too, because it is the only one that can.
#
# That second line is the part worth knowing, because it used to be otherwise. Neither
# other image can do the job:
#
#   robovast    carries the RoboVAST contract (/etc/robovast_compat_version,
#               scenario-execution, the /out mount) but no simulator.
#   roqsim-ros  roqsim's own image: carries roqsim but not that contract, so the runner
#               rejects it before a scenario starts -- and no workflow has ever published
#               the tag the ROS shape used to default to.
#
# Built by ``container/robovast/build.sh --image roqsim`` and by CI, on top of a *resolved*
# base tag (BASE_IMAGE) so the two images cannot drift apart. The compat version is
# inherited from that base rather than restated here -- one file, one source.

# Where roqsim comes from, defaulted HERE rather than in whatever invokes the build: a
# Dockerfile that cannot build on its own is one that only works through a wrapper, and both
# this image and the base image were exactly that -- their source COPY needed a directory git
# cannot track (an empty one), staged by build.sh into a temp context. CI builds with
# `context: .`, so neither job could ever have succeeded, which is why nothing published the
# images the defaults named.
#
# Pinned to a COMMIT, not a branch, and that is what makes a bare `docker build` of this file
# reproducible: the clone layer's cache key is the command text plus its ARGs, never the state of
# the remote, so a branch default serves the tree from the first build forever (see the caching
# note below). build.sh and CI resolve their own ref to a sha and pass it, overriding this.
ARG ROQSIM_REPO=https://github.com/cps-test-lab/roqsim.git
# The default must be able to build this file on its own, or it is not a default: the install list
# below names `roqsim_aerial`, so a pin from before that package existed fails on a path the clone
# does not contain. This one also carries the `payload` and `wind_field` plugins the drone example
# configures.
ARG ROQSIM_REF=4612b5ee09f85a78dcab66b83d18bb914cd7918d

# Up here with them, and not beside the FROM it feeds: an ARG referenced by a FROM must be
# declared before the FIRST FROM in the file, or it is out of scope and the base name resolves
# to the empty string ("base name should not be blank").
ARG BASE_IMAGE=ghcr.io/cps-test-lab/robovast:latest

# Digest-pinned for the reason the base image's alpine/git pin gives: an untagged FROM
# resolves to whatever :latest points at on the day of the build, so two builds of the
# same commit can clone with different git versions. This is alpine/git v2.54.0, the same
# digest container/robovast/Dockerfile uses -- refresh both with make refresh-build-pins.
FROM alpine/git@sha256:a299a963fbe31628ab481ca42907bcf0691d004f86734c02638abdf513691d42 AS roqsim-clone
ARG ROQSIM_REPO
ARG ROQSIM_REF
# A full clone then checkout, the same shape as the base image's scenario-execution stage, and
# for a reason: ``--depth 1 --branch <ref>`` cannot check out a bare commit sha, and a sha is
# what build.sh and CI pass (see below). One idiom that takes a branch, a tag or a sha beats two
# that each take some of them. .git is dropped afterwards -- no layer below reads it, and it is
# also where a credentialled clone would leave the token behind.
#
# NOTE ON CACHING: this layer's cache key is the command text plus the ARGs, not the state of
# the remote. With a *branch* in ROQSIM_REF the cache therefore serves the tree from the first
# build forever, however far the branch has moved -- so build.sh resolves the ref to a sha with
# ``git ls-remote`` before building, which makes the key change exactly when the remote does. A
# bare ``docker build`` that leaves the branch default needs ``--no-cache`` to pick up new
# commits; that is the cost of a default that is not a pin.
#
# The token is optional and arrives as a BuildKit secret. roqsim is PUBLIC now, so an anonymous
# clone works and the secret is only needed for a fork that is not -- it used to be required, and
# without it the clone failed with "could not read Username for 'https://github.com'", which is
# git asking for a password on a terminal that does not exist. A secret rather than a build arg so
# the value is not recorded in the image history; only this command's text is, and the value is
# read from the mount at run time.
#
#   docker buildx build --secret id=git_token,env=GITHUB_TOKEN ...
RUN --mount=type=secret,id=git_token \
    url="$ROQSIM_REPO"; \
    if [ -s /run/secrets/git_token ]; then \
      url="https://x-access-token:$(cat /run/secrets/git_token)@${ROQSIM_REPO#https://}"; \
    fi; \
    if ! { git clone "$url" /src 2>/tmp/clone.err \
           && git -C /src checkout --quiet "$ROQSIM_REF" 2>>/tmp/clone.err; }; then \
      sed 's/x-access-token:[^@]*@/x-access-token:***@/g' /tmp/clone.err >&2; \
      echo "" >&2; \
      echo "Could not clone $ROQSIM_REPO at '$ROQSIM_REF'." >&2; \
      echo "roqsim IS public, so this is most likely a ref that does not exist rather than" >&2; \
      echo "an access problem -- note that the branch is now 'main'. Either:" >&2; \
      echo "  - check the ref:          --build-arg ROQSIM_REF=<branch|tag|sha>" >&2; \
      echo "  - build from a checkout:  build.sh --image roqsim --roqsim-src <path>" >&2; \
      echo "  - pass a token, for a private fork:  --secret id=git_token,env=GITHUB_TOKEN" >&2; \
      echo "  - or point elsewhere:     --build-arg ROQSIM_REPO=<url>" >&2; \
      exit 1; \
    fi \
 && rm -rf /src/.git

# The source tree, as a filesystem with nothing else in it. Its whole purpose is to be
# *overridable*: `docker buildx build --build-context roqsim-src=../roqsim` replaces this stage
# with a local checkout, so a working tree and a clone reach the COPY below through one code
# path -- no build-arg branch, and no directory that has to exist in the repository.
FROM scratch AS roqsim-src
COPY --from=roqsim-clone /src /

FROM ${BASE_IMAGE}
SHELL ["/bin/bash", "-xo", "pipefail", "-c"]

USER root

##############################################################
####            MuJoCo's runtime GL libraries             ####
##############################################################
# `import mujoco` links against libGL even for a trial that renders nothing, so these are
# needed by every roqsim run and not only by camera worlds. Both offscreen backends are
# installed because which one works is a property of the *node*: egl needs a render
# device, osmesa is the software fallback for a CPU-only one. roqsim chooses between
# them at startup (roqsim.viewer.select_offscreen_gl) -- it is the only place that can, so
# no campaign has to guess.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libegl1 \
        libgl1-mesa-dri \
        libosmesa6 \
        libglib2.0-0 \
        libgomp1 \
        ros-"${ROS_DISTRO}"-simulation-interfaces && \
    rm -rf /var/lib/apt/lists/*

##############################################################
####                      MoveIt 2                        ####
##############################################################
# The planner half of an arm campaign, and it is here rather than in the base image because
# an arm cell is a roqsim cell: what executes a MoveIt trajectory is roqsim's own bridge
# (the FollowJointTrajectory and GripperCommand actions `arm_controller` declares), so an
# image carrying MoveIt and no roqsim would have nothing to plan against. The base carries
# `moveit-msgs` for the other half of the split -- a scenario driving move_group as a client
# needs the interfaces, not the servers.
#
# `moveit-planners-ompl` and `moveit-kinematics` are explicit rather than left to
# `moveit-ros-move-group`'s dependencies: move_group loads the OMPL planner and the KDL
# kinematics plugin BY NAME at run time, so a missing one surfaces as a planning request that
# fails rather than as an image that fails to build.
#
# Not behind an ARG, unlike the torch packages below. The gate there is justified by several
# hundred MB on an image every campaign pulls; this is a fraction of that, and the base
# already carries nav2 and ros2-control unconditionally.
# hadolint ignore=DL3008
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ros-"${ROS_DISTRO}"-moveit-ros-move-group \
        ros-"${ROS_DISTRO}"-moveit-planners-ompl \
        ros-"${ROS_DISTRO}"-moveit-kinematics \
        ros-"${ROS_DISTRO}"-moveit-simple-controller-manager && \
    rm -rf /var/lib/apt/lists/*

##############################################################
####                      roqsim                        ####
##############################################################
# From the ``roqsim-src`` stage above: a clone of the pinned ref by default, or whatever a
# ``--build-context roqsim-src=<path>`` pointed it at. robovast vendors no copy of roqsim and
# has no submodule, deliberately, so each repository stays publishable on its own.
#
# Why the distinction matters more than it looks: a clone builds roqsim as *pushed*, which is
# routinely not what a developer has in front of them -- and an image built from the wrong
# source fails in ways that look like the integration is broken rather than stale.
# ``build.sh --roqsim-src`` is the answer; the build log says which was used.
COPY --from=roqsim-src / /opt/roqsim

# Into the ROS **system** interpreter, with --break-system-packages, which is what
# roqsim's own image does (container/Dockerfile.ros) and for the same reason: nodes are
# launched by `ros2 launch` with /usr/bin/python3, and a package it cannot import is not
# installed as far as a run is concerned.
#
# Deliberately not the /usr/local venv that an *experiment* image build creates
# (image_build.py's _VENV_SETUP). That venv does not exist in this base -- it is made by
# the build that needs it -- and reproducing its incantation here would give one fact two
# homes, free to drift. A later campaign build layered on this image still creates it,
# with --system-site-packages, so it sees everything installed here.
#
# PIP_CONSTRAINT is inherited from the base (numpy<2), which is what stops pip pulling a
# numpy that breaks rclpy's ABI.
#
# One pip pass over all of them, so a package's dependency on a sibling resolves against
# that sibling rather than against PyPI -- where `roqsim` is an unrelated project. This is
# the same reason the campaigns that used to carry a wheel list installed them as one
# group; the difference is that nobody has to maintain the list any more.
#
# `scenario_execution_roqsim` is the substrate's OSC action library, and it is in this list for a
# reason worth knowing: a campaign whose scenario writes `import osc.roqsim` fails at scenario PARSE
# time without it ("No plugins found for action ..."), before a single step runs. Its own
# scenario-execution dependency is deliberately not declared (see its pyproject) -- this image already
# carries that as a colcon package under /ws, and a pip'd copy from PyPI would be a different, older
# project sitting on the same sys.path.
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install --break-system-packages \
        "mujoco>=3.0" \
        /opt/roqsim/roqsim \
        /opt/roqsim/roqsim_assets \
        /opt/roqsim/roqsim_sensors \
        /opt/roqsim/roqsim_mobile \
        /opt/roqsim/roqsim_manipulation \
        /opt/roqsim/roqsim_manipulation_assets \
        /opt/roqsim/roqsim_mobile_manipulation \
        /opt/roqsim/roqsim_aerial \
        /opt/roqsim/roqsim_scenes \
        /opt/roqsim/roqsim_walker \
        /opt/roqsim/roqsim_webctrl \
        /opt/roqsim/scenario_execution_roqsim

# The learned-policy platforms, behind a switch because they pull CPU torch: quadruped +
# humanoid are ~80 MB of assets and torch several hundred more, on an image that every
# campaign pulls -- including the ones that never load a policy.
#
# Named and tested exactly as roqsim's own lean image does it (container/Dockerfile:
# ``ARG INCLUDE_TORCH_PKGS=0`` and ``= "1"``), so "which image has the legged platforms"
# reads the same in both repos. The ``= "1"`` rather than a non-empty test is deliberate:
# ``--build-arg INCLUDE_TORCH_PKGS=0`` must mean off, which is what a reader expects it to
# mean.
#
# Note the asymmetry with roqsim's *ROS* image, which installs torch unconditionally. This
# image serves the ROS shape now, so a legged-robot ROS campaign needs this switch on
# where it previously got torch for free. That is the deliberate trade: the default image
# stays small for the mobile campaigns that are the common case.
#
# torch on its own line and with --index-url, not --extra-index-url: the CPU wheel index
# does not carry the roqsim packages' other dependencies, so a single pass that mixed them
# would resolve those against it and fail.
ARG INCLUDE_TORCH_PKGS=0
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    if [ "${INCLUDE_TORCH_PKGS}" = "1" ]; then \
      echo "legged platforms: installing quadruped + humanoid (CPU torch)" && \
      pip install --break-system-packages torch --index-url https://download.pytorch.org/whl/cpu && \
      pip install --break-system-packages \
        /opt/roqsim/roqsim_quadruped \
        /opt/roqsim/roqsim_humanoid ; \
    else \
      echo "legged platforms: skipped (build with --build-arg INCLUDE_TORCH_PKGS=1)" ; \
    fi

# The ROS bridge and the nav2 example are colcon packages, not pip ones: they register
# the `ros2_bridge` / `sim_interfaces` plugins a world gets when a run asks for transport.
#
# Built into **/ws**, the overlay the RoboVAST entrypoint already sources -- not into a
# second workspace of their own. A separate overlay has to be sourced by something, and
# the entrypoint sources exactly two setups (`/opt/ros/$ROS_DISTRO` and `/ws/install`);
# adding a third would mean changing RoboVAST's contract to accommodate one simulator.
# Putting a `source` line in /etc/bash.bashrc does NOT work and is the trap here: the
# entrypoint runs non-interactively, so bashrc is never read, and the bridge would be
# missing at exactly the moment a campaign asks for transport.
#
# --packages-select so only these two build; /ws already holds a built scenario-execution
# and rebuilding it would cost minutes for nothing.
# hadolint ignore=DL3003
RUN ln -s /opt/roqsim/ros2_ws/src/roqsim_ros_bridge /ws/src/roqsim_ros_bridge && \
    ln -s /opt/roqsim/ros2_ws/src/roqsim_nav2_example /ws/src/roqsim_nav2_example && \
    . "/opt/ros/${ROS_DISTRO}/setup.bash" && \
    cd /ws && \
    colcon build --packages-select roqsim_ros_bridge roqsim_nav2_example

USER ubuntu:ubuntu

# Which roqsim went in. A build ARG is invisible from outside the build, so without this the only
# way to answer "which roqsim is in this image?" is to read the Dockerfile at the robovast commit
# in org.opencontainers.image.revision -- which assumes that commit is still reachable and that
# the ref was not overridden at build time. It usually is: build.sh resolves ROQSIM_REF to a sha
# before building, precisely so the ARG is not a moving branch.
ARG ROQSIM_REF
LABEL org.robovast.roqsim-ref="${ROQSIM_REF}"
