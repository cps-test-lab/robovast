version: 2
configuration:
- name: navigation
  variations:
  - FloorplanVariation:
      scenario: {map: map_file, mesh: mesh_file}
      variation_files:
      - floorplans/rooms/rooms.variation
      #- floorplans/hallways/hallways.variation
      num_variations: 1
      seed: 1
  - PathVariationRandom:
      scenario: {start: start_pose, goal: goal_pose}
      num_goal_poses: 1
      path_length: 10.0
      num_paths: 2
      path_length_tolerance: 0.5
      min_distance: 1.0
      seed: 42
      robot_diameter: 0.35
  - ObstacleVariation:
      scenario: {objects: static_objects}
      obstacle_configs:
      - amount: 1
        max_distance: 0.1
        model: file:///config/files/models/box.sdf.xacro
        xacro_arguments: width:=0.5, length:=0.5, height:=1.0
      seed: 42
      robot_diameter: 0.35
  - ParameterVariationList:
      scenario: laserscan_gaussian_noise_std_deviation
      values:
      - 0.0
      - 0.1
execution:
  containers:
    scenario:
      image: ghcr.io/cps-test-lab/robovast:latest
      resources:
        cpu: 8
  runs: 10
  scenario_file: scenario.osc
  run_files:
  - "**/files/*"
results_processing:
  postprocessing:
  - rosbags_to_csv
  - rosbags_tf_to_csv:
      frames: [base_link, turtlebot4_base_link_gt]
evaluation:
  visualization:
  - Analysis:
      run: analysis/analysis_run.ipynb
      config: analysis/analysis_config.ipynb
      campaign: analysis/analysis_campaign.ipynb
