version: 2
configuration:
- name: navigation
  parameters:
  - start_pose:
      position:
        x: 2
        y: 6
      orientation:
        yaw: 2
  - goal_pose1:
      position:
        x: 2
        y: 7
      orientation:
        yaw: 2
  - goal_pose2:
      position:
        x: 2
        y: 8
      orientation:
        yaw: 2
  - goal_pose3:
      position:
        x: 1
        y: 8
      orientation:
        yaw: 1
  - goal_pose4:
      position:
        x: 1
        y: 7
      orientation:
        yaw: 1
  - goal_pose5:
      position:
        x: 1
        y: 6
      orientation:
        yaw: 1
  variations:
  - FloorplanVariation:
      scenario: {map: map_file, mesh: mesh_file}
      variation_files:
      - floorplans/rooms/rooms.variation
      #- floorplans/hallways/hallways.variation
      num_variations: 1
      seed: 1
  - ParameterVariationList:
      scenario: laserscan_gaussian_noise_std_deviation
      values:
      - 0.0
      - 0.1
execution:
  containers:
    scenario:
      resources:
        cpu: 8
  runs: 10
  scenario_file: scenario.osc
  run_files:
  - "**/files/*"
results_processing:
  postprocessing:
  - rosbags_to_csv
  - rosbags_tf_to_csv:
      frames: [base_link, turtlebot4_base_link_gt]
visualization:
  results:
    explorer:
      notebooks:
      - Analysis:
          run: analysis/analysis_run.ipynb
          config: analysis/analysis_config.ipynb
          campaign: analysis/analysis_campaign.ipynb
