#!/bin/sh
#
# @name X500 V2 (external MAVLink simulator)
#
# @type Quadrotor x
# @class Copter
#
# PX4 ships no such airframe: every x500 airframe sets SIM_GZ_EN and so routes to Gazebo before
# the MAVLink HIL path, and the only `none_*` airframe is the Iris. This is 10016_none_iris with
# the x500's control-allocation table from 4001_gz_x500 (PX4 v1.18). px4_start.sh installs it.
# Select with PX4_SIM_MODEL=none_x500 or PX4_SYS_AUTOSTART=10020.

. ${R}etc/init.d/rc.mc_defaults

param set-default CA_AIRFRAME 0
param set-default CA_ROTOR_COUNT 4

# FRD body frame. The sign of KM is the spin direction. Rotor order must match the simulator's
# `multirotor_motors` (which is FLU: every PY sign flips there).
param set-default CA_ROTOR0_PX 0.174
param set-default CA_ROTOR0_PY 0.174
param set-default CA_ROTOR0_KM 0.05
param set-default CA_ROTOR1_PX -0.174
param set-default CA_ROTOR1_PY -0.174
param set-default CA_ROTOR1_KM 0.05
param set-default CA_ROTOR2_PX 0.174
param set-default CA_ROTOR2_PY -0.174
param set-default CA_ROTOR2_KM -0.05
param set-default CA_ROTOR3_PX -0.174
param set-default CA_ROTOR3_PY 0.174
param set-default CA_ROTOR3_KM -0.05

param set-default PWM_MAIN_FUNC1 101
param set-default PWM_MAIN_FUNC2 102
param set-default PWM_MAIN_FUNC3 103
param set-default PWM_MAIN_FUNC4 104

# Ties this airframe to the simulator's actuators: 2.0 kg * 9.80665 / 0.6 = 32.7 N, 8.2 N per
# rotor, which is the model's ctrlrange. Unloaded T/W 1.67.
param set-default MPC_THR_HOVER 0.6
