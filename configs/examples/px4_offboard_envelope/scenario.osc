import osc.helpers
import osc.ros

# Bring PX4 up, switch to Offboard, arm, fly a 10 x 10 m square at 3 m, land, disarm.
#
# This file owns WHEN; files/offboard_stream.py owns WHAT PX4 REQUIRES (the setpoint streams and
# every VehicleCommand). Offboard needs a stream above 2 Hz that is already running before the
# mode switch, and VehicleCommand needs a current timestamp; neither is expressible with
# topic_publish, so the scenario publishes phase names and legs to the node instead.
#
# Legs are fixed waits, not arrival checks: a run that cannot hold altitude must fly the same
# schedule, or the cells are not comparable.

scenario test_scenario:
    timeout(180s)

    do serial:
        serial:
            timeout(120s)
            wait_for_topics(topics: ['/clock'])

            # Bridges PX4's uORB topics onto ROS 2; PX4 dials in on UDP 8888. Built from source by
            # the .vast's ros_packages.
            run_process(command: 'MicroXRCEAgent udp4 -p 8888', wait_for_shutdown: false)

            # The `_vN` suffix is appended at runtime from each message's MESSAGE_VERSION, so it
            # is a property of the PX4 release. Verified on v1.18.0-beta2: local position is _v1,
            # vehicle_status is already _v4, the /fmu/in topics are unsuffixed. After a PX4 image
            # bump re-check with `ros2 topic list | grep fmu/` and change this, files/metrics.py
            # and the .vast's bag topics together.
            wait_for_data(topic_name: '/fmu/out/vehicle_local_position_v1',
                          topic_type: 'px4_msgs.msg.VehicleLocalPosition',
                          qos_profile: qos_preset_profiles!sensor_data)

            # Streams the pad as setpoint from t=0, so the mode switch below is accepted.
            run_process(command: 'python3 /config/files/offboard_stream.py',
                        wait_for_shutdown: false)

        # Ground truth comes from the simulator's sim_poses.csv; the bag carries EKF2's belief.
        bag_record([
                '/clock',
                '/fmu/out/vehicle_local_position_v1'
            ],
            use_sim_time: true)

        # offboard_stream subscribes with transient-local durability; a volatile publisher would
        # never match it. Mode first, then arm: PX4 acknowledges asynchronously.
        serial:
            log(msg: 'switch to offboard')
            topic_publish(topic_name: '/course/phase',
                          topic_type: 'std_msgs.msg.String',
                          value: '{\"data\": \"offboard\"}',
                          qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(2s)

            log(msg: 'arm')
            topic_publish(topic_name: '/course/phase',
                          topic_type: 'std_msgs.msg.String',
                          value: '{\"data\": \"arm\"}',
                          qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(3s)

        # NED: [north, east, DOWN]. z = -3.0 is 3 m up. The node passes these through unconverted;
        # the world's markers are the same corners in ENU.
        serial:
            log(msg: 'climb to 3 m over the pad and settle')
            topic_publish(
                topic_name: '/course/ned_setpoint',
                topic_type: 'geometry_msgs.msg.PointStamped',
                value: '{\"header\": {\"frame_id\": \"ned\"}, \"point\": {\"x\": 0.0, \"y\": 0.0, \"z\": -3.0}}',
                qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(12s)

            log(msg: 'leg 1 -> N=5 E=5 D=-3')
            topic_publish(
                topic_name: '/course/ned_setpoint',
                topic_type: 'geometry_msgs.msg.PointStamped',
                value: '{\"header\": {\"frame_id\": \"ned\"}, \"point\": {\"x\": 5.0, \"y\": 5.0, \"z\": -3.0}}',
                qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(12s)

            log(msg: 'leg 2 -> N=5 E=-5 D=-3')
            topic_publish(
                topic_name: '/course/ned_setpoint',
                topic_type: 'geometry_msgs.msg.PointStamped',
                value: '{\"header\": {\"frame_id\": \"ned\"}, \"point\": {\"x\": 5.0, \"y\": -5.0, \"z\": -3.0}}',
                qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(12s)

            log(msg: 'leg 3 -> N=-5 E=-5 D=-3')
            topic_publish(
                topic_name: '/course/ned_setpoint',
                topic_type: 'geometry_msgs.msg.PointStamped',
                value: '{\"header\": {\"frame_id\": \"ned\"}, \"point\": {\"x\": -5.0, \"y\": -5.0, \"z\": -3.0}}',
                qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(12s)

            log(msg: 'return over the pad')
            topic_publish(
                topic_name: '/course/ned_setpoint',
                topic_type: 'geometry_msgs.msg.PointStamped',
                value: '{\"header\": {\"frame_id\": \"ned\"}, \"point\": {\"x\": 0.0, \"y\": 0.0, \"z\": -3.0}}',
                qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(12s)

        # `land` is PX4's landing mode (descent profile, ground detection, auto-disarm). The explicit
        # disarm is a backstop for an aircraft that never got airborne.
        serial:
            log(msg: 'land')
            topic_publish(topic_name: '/course/phase',
                          topic_type: 'std_msgs.msg.String',
                          value: '{\"data\": \"land\"}',
                          qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(25s)

            log(msg: 'disarm')
            topic_publish(topic_name: '/course/phase',
                          topic_type: 'std_msgs.msg.String',
                          value: '{\"data\": \"disarm\"}',
                          qos_profile: qos_preset_profiles!system_default_transient_local)
            wait elapsed(3s)

            log(msg: 'trial complete')
