version: 3

metadata:
  name: px4_offboard_envelope
  title: PX4 offboard flight envelope on an X500-class quadrotor in roqsim (MuJoCo)
  description: >
    The same physical question as drone_flight_envelope -- does the aircraft hold its commanded
    course as its thrust margin is eaten away? -- flown by a REAL flight stack. A ~2 kg X500-class
    quadrotor is commanded from ROS 2 with px4_msgs offboard setpoints; those reach PX4 SITL over
    uXRCE-DDS, and PX4 flies the airframe in roqsim's MuJoCo physics over the documented Simulator
    MAVLink API on TCP 4560. Nothing that stabilises the aircraft is ours: EKF2, the position and
    attitude controllers, the control allocator and the failsafes are all PX4's, running the code
    an operator flashes onto a vehicle.

    PX4 hovers this airframe at 60% throttle (MPC_THR_HOVER 0.6), so the four rotors together
    deliver 32.7 N against a 19.6 N airframe -- an unloaded thrust-to-weight ratio of 1.67. The
    grid walks payload, air density and wind until that margin is gone.
  keywords: [robotics, aerial, drone, quadrotor, PX4, px4_msgs, offboard, uXRCE-DDS, MAVLink, mujoco, roqsim]

# 3 x 2 x 2 grid. `sim:` paths are addresses into world/px4_envelope.yaml. Nothing inside PX4 is
# varied: the flight stack is the thing under test.
configuration:
- name: envelope
  variations:

  # Total thrust is 32.7 N (files/10020_none_x500: MPC_THR_HOVER 0.6 on 2.0 kg), so payload sets
  # T/W: 1.67 / 1.28 / 1.04. T/W = 1 at 3.334 kg.
  - ParameterVariationList:
      sim: components.drone.payload.mass
      values: [0.0, 0.6, 1.2]

  # Sea level and ~3000 m. Density only scales drag (and so the wind's force); thrust is fixed by
  # the model's ctrlrange, so this is an interaction with wind, not a second thrust-margin factor.
  - ParameterVariationList:
      sim: sim.density
      values: [1.225, 0.905]

  # A list destination is replaced wholesale; there is no index addressing.
  - ParameterVariationList:
      sim: components.wind_field.steady
      values:
      - [0.0, 0.0, 0.0]
      - [4.0, 0.0, 0.0]

execution:
  containers:
    simulation:
      backend: roqsim
      config: world/px4_envelope.yaml
      # An optional extra of roqsim_aerial (`roqsim_aerial[px4]`), so the simulator image does not
      # carry a MAVLink stack for the worlds that fly the in-process controller.
      python_packages: [pymavlink]
      resources: {cpu: 1, cpu_limit: 4, memory: 2048Mi}

    px4:
      # The PX4 project's own prebuilt SITL image. Only pre-release tags exist. Pinned because PX4's
      # ROS 2 topic names change between releases (see scenario.osc).
      image: px4io/px4-sitl:v1.18.0-beta2
      provenance:
        source: https://github.com/PX4/PX4-Autopilot
        revision: v1.18.0-beta2
        build_recipe: published by the PX4 project; see https://hub.docker.com/r/px4io/px4-sitl
      # A sidecar's command is word-split unquoted by secondary_entrypoint.sh, so anything with a
      # space needs a script.
      command: [/bin/bash, /config/files/px4_start.sh]
      # The image ships no python3, which secondary_entrypoint.sh requires.
      system_packages: [python3]
      resources: {cpu: 1, cpu_limit: 2, memory: 512Mi}

    scenario:
      # Neither has a Debian on any ROS 2 distribution or a PyPI release, so both are colcon-built
      # from pinned sources into this campaign's derived image.
      ros_packages:
      # Must match the PX4 release above: the uXRCE-DDS client derives each topic's `_vN` suffix
      # from the message's MESSAGE_VERSION, so interfaces from another branch produce topic names
      # that do not match the running autopilot.
      - git: https://github.com/PX4/px4_msgs.git
        ref: 598c7aad7b2386f9406ebd2a2f841619fddc3c78   # release/1.18 HEAD
      # A plain CMake project; its colcon.pkg supplies the name, type and the cmake args that link
      # the ROS distribution's Fast DDS. Stays on 2.x: 3.x needs Fast DDS 3, jazzy ships 2.14.
      - git: https://github.com/eProsima/Micro-XRCE-DDS-Agent.git
        ref: 73622810d984349b80bbac0ef55fc0b694d62222   # v2.4.3
      resources: {cpu: 1, cpu_limit: 2, memory: 1024Mi}

  # All containers of a run share one network namespace: PX4 reaches TCP 4560 and the DDS agent
  # UDP 8888 on localhost.
  mode: ros2
  # Turbulence and EKF2 convergence both vary with the run, so repetitions sample rather than repeat.
  runs: 3
  # ~95 s of schedule plus ~30 s of PX4 bringup; a backstop, not a bound on the flight.
  timeout: 420
  scenario_file: scenario.osc
  run_files:
  # Per extension: a bare "world/*" would sweep __pycache__ into the config identity hash. Mounted
  # at /config/<path> in every container, which is how the PX4 image gets its start script.
  - "world/*.yaml"
  - "world/*.xml"
  - "files/*.py"
  - "files/*.sh"
  - "files/10020_none_x500"   # airframe files carry no extension
  env:
  - PYTHONUNBUFFERED: "1"

results_processing:
  postprocessing:
  # Ground truth comes from sim_poses.csv, which every roqsim run writes; the bag carries only
  # what EKF2 believed.
  - rosbags_to_csv: {topics: [/fmu/out/vehicle_local_position_v1]}
  - files/metrics.py:EnvelopeMetrics

visualization:
  config:
    panels:
    - parameters: {title: Flight envelope, height: "40%"}
    - scene3d: {title: Flight room}

  results:
    run_view:
      panels:
      # Declared so it can claim `fill`; the automatic one takes only what the docks leave.
      - scene3d: {title: Flight room, fill: true}

      # trajectory is at the simulator rate against a 5000-row reply cap that truncates at the
      # head; undecimated, every panel showed the first ten seconds only. ENU (from sim_poses.csv).
      - scene:
          title: Ground track
          position: {anchor: top-left, width: 360, height: 360}
          minimizable: true
          source: {table: trajectory, time_column: t, decimate_hz: 50}
          x: x
          y: y
          trail: true

      # `fields` entries must be objects; a bare column name renders as a dash.
      - state:
          title: Flight state
          position: {anchor: top-right, width: 320, height: 220}
          minimizable: true
          source: {table: trajectory, time_column: t, decimate_hz: 50}
          fields:
          - {column: z, label: altitude, unit: m}
          - {column: tilt_deg, label: tilt, unit: deg}
          - {column: speed, label: speed, unit: m/s}
          - {column: est_error, label: estimator error, unit: m}
          - {column: x, label: x, unit: m}
          - {column: y, label: y, unit: m}

      - timeseries:
          title: Altitude, tilt and speed
          position: {anchor: bottom-right, width: 460, height: 240}
          minimizable: true
          source: {table: trajectory, time_column: t, decimate_hz: 50}
          series:
          - {column: z, label: "altitude [m]"}
          - {column: tilt_deg, label: "tilt [deg]"}
          - {column: speed, label: "speed [m/s]"}

      - timeseries:
          title: Truth vs PX4 estimate (altitude)
          position: {anchor: bottom-left, width: 400, height: 240}
          minimizable: true
          source: {table: trajectory, time_column: t, decimate_hz: 50}
          series:
          - {column: z, label: "truth [m]"}
          - {column: est_z, label: "EKF2 [m]"}

      # The explicit width is what keeps `bottom-center` floating above the playback bar. PX4's
      # own arming refusals appear here.
      - log:
          title: Run log
          position: {anchor: bottom-center, width: "calc(100% - 900px)", height: 200}
          minimizable: true
          minimized: true

      timeline: {table: trajectory, time_column: t}

    data_browser:
      plots:
      - title: Altitude held vs payload and wind
        query: >
          SELECT r.config_name AS config,
                 m.cruise_hold_fraction AS held,
                 m.mean_altitude_error AS altitude_error,
                 m.max_tilt_deg AS max_tilt,
                 m.mean_estimator_error AS estimator_error,
                 m.outcome AS outcome
          FROM runs r
          JOIN metrics m ON (m.config_name = r.config_name AND m.run_id = r.run_id)
        vega_lite:
          mark: point
          encoding:
            x: {field: altitude_error, type: quantitative, title: "mean altitude error [m]"}
            y: {field: max_tilt, type: quantitative, title: "max tilt [deg]"}
            color: {field: outcome, type: nominal}
            shape: {field: outcome, type: nominal}
      - title: Estimator error vs thrust margin
        query: >
          SELECT r.config_name AS config,
                 m.mean_estimator_error AS estimator_error,
                 m.mean_altitude_error AS altitude_error,
                 m.outcome AS outcome
          FROM runs r
          JOIN metrics m ON (m.config_name = r.config_name AND m.run_id = r.run_id)
        vega_lite:
          mark: point
          encoding:
            x: {field: altitude_error, type: quantitative, title: "mean altitude error [m]"}
            y: {field: estimator_error, type: quantitative, title: "mean |truth - EKF2| [m]"}
            color: {field: outcome, type: nominal}
