import osc.helpers
import osc.ros
import osc.nav2
import osc.remote

scenario test_scenario:
    robot: differential_drive_robot
    goal_pose: pose_3d

    do serial:
        serial:
            timeout(60s)
            wait_for_topics(topics: ['/clock'])
            check_data(topic_name: '/scan',
                       topic_type: 'sensor_msgs.msg.LaserScan',
                       member_name: 'range_max',
                       comparison_operator: comparison_operator!gt,
                       expected_value: '0.0',
                       qos_profile: qos_preset_profiles!sensor_data)
        parallel:
            ros_launch('', common.get_scenario_file_directory() + '/files/nav2_sut.launch.py',
                [key_value('params_file', common.get_scenario_file_directory() + '/files/nav2_params.yaml'),
                 key_value('map', common.get_scenario_file_directory() + '/files/depot.yaml'),
                 key_value('autostart', 'true')],
                wait_for_shutdown: false) with:
                    remote('ipc:///ipc/sut', setup_timeout: 120s)
            serial:
                robot.init_nav2(pose_3d())
                bag_record([
                        '/clock',
                        '/tf',
                        '/tf_static',
                        '/amcl_pose',
                        '/behavior_tree_log',
                        '/map',
                        '/global_costmap/costmap',
                        '/local_costmap/costmap',
                        '/scan',
                        '/odom'
                    ],
                    use_sim_time: true,
                    timestamp_suffix: false)
                robot.nav_to_pose(goal_pose)
                emit end
