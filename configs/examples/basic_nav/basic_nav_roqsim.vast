version: 4
metadata:
  name: basic_nav_roqsim
  title: Basic nav2 navigation on the roqsim (MuJoCo) TurtleBot 4 (Depot)
  description: |
    A TurtleBot 4 navigates the nav2 Depot world to a per-configuration goal with nav2 + AMCL, in
    roqsim (MuJoCo). The roqsim half of the basic_nav pair: same map, same nav2 params and the same
    measurement half as basic_nav_gazebo.vast, so a difference in results is attributable to the
    simulator. The bridge publishes the ROS graph Gazebo does, down to the ground-truth
    turtlebot4_base_link_gt frame.

    Three containers, and no image is built. `simulation` is roqsim, started by the backend from
    its own image. `sut` is a vanilla nav2 image: RoboVAST layers scenario_execution_server onto it
    and the scenario drives its launch over remote("ipc:///ipc/sut"). `scenario` is the stock
    RoboVAST image.

    One factor, on the `scenario:` channel: the goal.
  keywords: [robotics, navigation, ROS2, mujoco, roqsim, nav2, depot]
configuration:
- name: goal
  variations:
  # Map-frame goals; the robot starts at the map origin. Identical to basic_nav_gazebo.vast.
  - ParameterVariationList:
      scenario: goal_pose
      values:
      - position: {x: 21.0, y: 6.0}
      - position: {x: 21.0, y: 4.0}
      - position: {x: 21.0, y: -2.0}
      - position: {x: 21.0, y: -4.0}
      - position: {x: 21.0, y: -6.0}
visualization:
  config:
    panels:
    - parameters: {title: Scenario parameters, height: "35%"}
    - world: {title: World configuration, height: "15%"}
    - map2d:
        title: Map
        map: files/depot.yaml
        markers:
        - {kind: pose, pos: [0.0, 0.0], yaw: 0.0, label: start, color: "#60a5fa"}
        - {kind: pose, param: goal_pose, label: goal, color: "#4ade80"}
  results:
    run_view:
      panels:
      - nav2_behavior_tree:
          position: {anchor: top-left, width: 320, height: "calc(50% - 44px)"}
          minimizable: true
      - scenario_tree:
          title: Scenario
          position: {anchor: bottom-left, width: 320, height: "calc(50% - 44px)"}
          minimizable: true
          source: {table: behaviors}
      - costmap:
          title: Nav2 costmaps
          position: {anchor: top-right, width: 320, height: 550}
          minimizable: true
          layers:
            map: {topic: /map}
            global: {topic: /global_costmap/costmap}
            local: {topic: /local_costmap/costmap}
            poses: {table: poses}
      - log:
          title: Run log
          position: {anchor: bottom-center, width: "calc(100% - 680px)", height: 380}
          minimizable: true
          minimized: true
      # Speed is not a recorded column, so it is derived here from consecutive poses. The Gazebo
      # half plots the same table with a plain `timeseries`, the cheaper spelling without one.
      - vega:
          title: base_link
          position: {anchor: bottom-right, width: 320, height: 380}
          minimizable: true
          source: {table: poses, filter: {frame: base_link}, decimate_hz: 5}
          vega_lite:
            resolve: {scale: {x: shared}}
            spacing: 8
            transform:
            - {calculate: "datum['position.x']", as: px}
            - {calculate: "datum['position.y']", as: py}
            - {calculate: "datum['orientation.yaw']", as: yaw}
            - window:
              - {op: lag, field: px, as: px0}
              - {op: lag, field: py, as: py0}
              - {op: lag, field: timestamp, as: t0}
              sort: [{field: timestamp}]
            - filter: "isValid(datum.t0)"
            - filter: "datum.timestamp - datum.t0 > 0"
            - calculate: >
                sqrt(pow(datum.px - datum.px0, 2) + pow(datum.py - datum.py0, 2))
                / (datum.timestamp - datum.t0)
              as: speed
            - window: [{op: mean, field: speed, as: speed_avg}]
              frame: [-9, 0]
              sort: [{field: timestamp}]
            vconcat:
            - height: 150
              encoding:
                x: {field: timestamp, type: quantitative, axis: null}
                y: {field: speed_avg, type: quantitative, title: "speed [m/s]"}
              layer:
              - mark: {type: line, opacity: 0.25, strokeWidth: 1}
                encoding: {y: {field: speed, type: quantitative}}
              - mark: {type: line, strokeWidth: 1.5}
            - height: 120
              transform: [{fold: [px, py, yaw], as: [series, value]}]
              mark: {type: line, strokeWidth: 1.5}
              encoding:
                x: {field: timestamp, type: quantitative, title: "t [s]"}
                y: {field: value, type: quantitative, title: pose}
                color: {field: series, type: nominal, legend: {title: null, orient: top}}
    explorer:
      notebooks:
      - Analysis:
          run: analysis/analysis_run.ipynb
          config: analysis/analysis_config.ipynb
          campaign: analysis/analysis_campaign.ipynb
execution:
  containers:
    simulation:
      backend: roqsim
      config: world/depot_nav2.yaml
      resources:
        cpu: 4
        memory: 2944Mi
    sut:
      image: family:robovast
      resources:
        cpu: 3
        memory: 640Mi
    scenario:
      resources:
        cpu: 2
        memory: 640Mi
  # The declared figures are each container's starting point and the ceiling a measured one may not
  # exceed; within them, the node's probe sizes each container from what it used.
  sizing: calibrated
  mode: ros2
  # 5 goals x 5 runs, the same as the Gazebo half: a comparison of two simulators wants the same
  # number of samples on each side.
  runs: 5
  timeout: 300
  scenario_file: scenario_roqsim.osc
  # Named rather than globbed: files/ is shared with the Gazebo half and run_files are hashed into
  # a configuration's identity, so a glob lets a Gazebo-only file change this roqsim configuration.
  run_files:
  - files/depot.yaml
  - files/depot.pgm
  - files/nav2_params.yaml
  - files/nav2_bt.xml
  - files/nav2_sut.launch.py
results_processing:
  health_checks:
  - nav2_control_loop_rate
  # Identical to basic_nav_gazebo.vast, so both halves' tables hold the same frames. `require` is
  # what the analysis reads: a run missing a frame fails rather than yielding an empty table.
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, turtlebot4_base_link_gt]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree: {bt_xml: files/nav2_bt.xml}
  - rosbags_costmap_to_csv:
      topics: [/map, /global_costmap/costmap, /local_costmap/costmap]
