version: 2
metadata:
  name: nav_search_cmaes
  title: An evolution strategy on the same two dimensions
  description: |
    CMA-ES against TPE on a smooth, low-dimensional space, at an equal budget --
    the comparison is the campaign. It also carries the plateau stop the exploitation
    campaign does not: `no_improvement` ends a search that has stopped learning, which
    is the failure mode a fixed batch budget cannot see.
  keywords: [robotics, navigation, ROS2, roqsim, nav2, search, evolution-strategy]

search:
  strategy: optuna
  strategy_parameters:
    sampler: cmaes
  search_space:
    gap_width:    {type: float, low: 0.4, high: 1.6}
    walker_dwell: {type: float, low: 0.0, high: 8.0}
  variations:
  - variations/doorway.py:DoorwayVariation:
      sim: {instances: components.barrier.instances}
      gap_width: $gap_width
  - ParameterVariationList:
      sim: components.pedestrian.dwell
      values: [$walker_dwell]
  postprocessing:
  # The FULL chain, not just the metrics plugin. `search.postprocessing` runs inside the
  # loop, before each batch is scored, and nothing else has converted the bags yet: the
  # results_processing block below runs only once the campaign is over. Listing only
  # NavMetrics here leaves it reading poses.csv and rosbag2_clearance.csv that do not exist,
  # and the extractor then refuses the batch -- correctly, but for a reason that reads like
  # a missing plugin in the world.
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, turtlebot4_base_link_gt]
  - rosbags_to_csv:
      topics: [/collision, /clearance]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree: {bt_xml: files/nav2_bt.xml}
  - search/nav_metrics.py:NavMetrics
  extract:
    plugin: search/nav_extract.py:NavExtract
    params: {aggregate: worst, timeout: 120.0}
  objectives:
  - {name: robustness, direction: minimize}
  per_batch: 8
  budget:
  - batches: 6
  stopping:
  - no_improvement: {patience: 3, min_delta: 0.02}
  seed: 1

execution:
  containers:
    # roqsim, from the deployment's project. Nothing here names an image: which registry it
    # comes from is ROBOVAST_PROJECT's business, and naming one pins the example to a site.
    simulation:
      backend: roqsim
      config: world/empty_room.yaml
      resources: {cpu: 1, memory: 2Gi}
    # The system under test, kept vanilla: a nav2 image plus the TB4 description. That is
    # the claim this shape makes -- point it at any nav2 image and it works.
    sut:
      image: family:robovast
      system_packages:
      - ros-jazzy-nav2-minimal-tb4-description
      resources: {cpu: 4, memory: 4Gi}
    scenario:
      resources: {cpu: 1.25, memory: 2Gi}
  mode: ros2
  # Declared with the memory limits, not instead of them: adding limits alone shrinks an
  # otherwise-unbounded /dev/shm down to them, and a run that overruns shared memory dies of
  # SIGBUS (exit 135) rather than a clean OOM -- which arrives with nothing explaining it.
  shm_size: 1Gi
  runs: 3
  # Declared, unlike every other example in this repo. Without it `stalled` is null, no
  # verdict about a wedged run is possible, and `vast wait` cannot exit on one. The trial
  # bounds itself at 120 s; this is the outer backstop for a run that wedges before its own
  # timeout arms.
  timeout: 300
  scenario_file: scenario_roqsim.osc
  run_files:
  # Per-extension rather than "files/*": that glob crosses '/', so it also sweeps
  # __pycache__/*.pyc -- and run_files are hashed into the config identity, so a stray
  # recompile perturbs it.
  - "files/*.yaml"
  - "files/*.pgm"
  - "files/*.xml"
  - "files/*.py"
  env:
  - PYTHONUNBUFFERED: "1"

results_processing:
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, turtlebot4_base_link_gt]
  - rosbags_to_csv:
      topics: [/collision, /clearance]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree: {bt_xml: files/nav2_bt.xml}
  - search/nav_metrics.py:NavMetrics
