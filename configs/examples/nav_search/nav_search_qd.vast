version: 2
metadata:
  name: nav_search_qd
  title: "A map of the different ways it goes wrong"
  description: |
    Quality-diversity, and the only campaign here that answers "how MANY kinds of
    trouble are there" rather than "how much". Its archive is keyed on how close the
    crossing came and how long it took, with the failure mode as a categorical axis --
    so a cell that collides and a cell that gives up are different entries rather than
    two points with the same score.
  keywords: [robotics, navigation, ROS2, roqsim, nav2, search, quality-diversity, diversity]

search:
  strategy: qd
  strategy_parameters:
    archive:
      type: grid
      measures:
        # Categorical: the archive declares the names and the extractor returns one, so
        # "it collided" and "it never arrived" occupy different cells instead of being
        # encoded into a number and decoded from a comment.
        failure_mode:  {values: [none, collision, timeout, goal_miss]}
        min_clearance: {low: -0.2, high: 1.5, bins: 10}
    sigma: 0.15
  search_space:
    gap_width:    {type: float, low: 0.4, high: 1.6}
    walker_dwell: {type: float, low: 0.0, high: 8.0}
  variations:
  - variations/doorway.py:DoorwayVariation:
      sim: {instances: components.barrier.instances}
      gap_width: $gap_width
  - ParameterVariationList:
      sim: components.pedestrian.dwell
      values: [$walker_dwell]
  postprocessing:
  # The bags have to be converted HERE, inside the loop: search.postprocessing runs before
  # each batch is scored, while results_processing runs once the campaign is over. Without
  # it the extractor reads a poses.csv that does not exist yet and refuses the batch.
  #
  # `rosbags_process` and not the `rosbags_*_to_csv` names the campaign-level block uses:
  # only the campaign-level orchestrator knows how to batch those into one, so naming them
  # here is reported as "Unknown postprocessing plugin", SKIPPED, and the campaign then
  # fails at the extractor for a reason that points at the world instead.
  #
  # KNOWN LIMITATION, and it blocks these campaigns on a cluster lane today: search
  # postprocessing runs IN THE CONTROLLER PROCESS (controller._run_postprocessing calls
  # run_postprocessing_commands directly), while campaign-level postprocessing is dispatched
  # in-cluster. So `rosbags_process` tries to launch its aux container from the controller
  # and resolves the image against the default project rather than the deployment's --
  # "cannot determine the container protocol version of ghcr.io/cps-test-lab/robovast:latest"
  # -- and exits 1. Everything downstream then sees no CSVs.
  #
  # The batch-mode grid is unaffected: its chain lives in results_processing, which is
  # dispatched properly. Until search postprocessing gets the same dispatch, a search
  # campaign on this lane cannot compute ROS-derived metrics inside its loop.
  - rosbags_process:
      plugins:
      - type: tf_to_csv
        frames: all
        require: [base_link, odom, turtlebot4_base_link_gt]
      - type: to_csv
        topics: [/collision, /clearance]
      - type: nav2_bt_to_csv
  - search/nav_metrics.py:NavMetrics
  extract:
    plugin: search/nav_extract.py:NavExtract
    params: {aggregate: worst, timeout: 120.0}
  objectives:
  - {name: robustness, direction: minimize}
  per_batch: 8
  budget:
  # Time, not batches: an archive fills for as long as it is given, and there is no
  # meaningful "done" short of the budget running out.
  - time: 5400
  stopping:
  - metric: {name: coverage, op: '>=', value: 0.35}
  seed: 1

execution:
  containers:
    # roqsim, from the deployment's project. Nothing here names an image: which registry it
    # comes from is ROBOVAST_PROJECT's business, and naming one pins the example to a site.
    simulation:
      backend: roqsim
      config: world/empty_room.yaml
      resources: {cpu: 1, memory: 2Gi}
    # The system under test, kept vanilla: a nav2 image plus the TB4 description. That is
    # the claim this shape makes -- point it at any nav2 image and it works.
    sut:
      image: family:robovast
      system_packages:
      - ros-jazzy-nav2-minimal-tb4-description
      resources: {cpu: 4, memory: 4Gi}
    scenario:
      resources: {cpu: 1.25, memory: 2Gi}
  mode: ros2
  # Declared with the memory limits, not instead of them: adding limits alone shrinks an
  # otherwise-unbounded /dev/shm down to them, and a run that overruns shared memory dies of
  # SIGBUS (exit 135) rather than a clean OOM -- which arrives with nothing explaining it.
  shm_size: 1Gi
  runs: 3
  # Declared, unlike every other example in this repo. Without it `stalled` is null, no
  # verdict about a wedged run is possible, and `vast wait` cannot exit on one. The trial
  # bounds itself at 120 s; this is the outer backstop for a run that wedges before its own
  # timeout arms.
  timeout: 300
  scenario_file: scenario_roqsim.osc
  run_files:
  # Per-extension rather than "files/*": that glob crosses '/', so it also sweeps
  # __pycache__/*.pyc -- and run_files are hashed into the config identity, so a stray
  # recompile perturbs it.
  - "files/*.yaml"
  - "files/*.pgm"
  - "files/*.xml"
  - "files/*.py"
  env:
  - PYTHONUNBUFFERED: "1"

results_processing:
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, turtlebot4_base_link_gt]
  - rosbags_to_csv:
      topics: [/collision, /clearance]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree: {bt_xml: files/nav2_bt.xml}
  - search/nav_metrics.py:NavMetrics
