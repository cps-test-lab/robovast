version: 3
metadata:
  name: nav_search_qd
  title: "A map of the different ways it goes wrong"
  description: |
    Quality-diversity, and the only campaign here that answers "how MANY kinds of
    trouble are there" rather than "how much". Its archive is keyed on how close the
    crossing came and how long it took, with the failure mode as a categorical axis --
    so a cell that collides and a cell that gives up are different entries rather than
    two points with the same score.
  keywords: [robotics, navigation, ROS2, roqsim, nav2, search, quality-diversity, diversity]

search:
  strategy: qd
  strategy_parameters:
    archive:
      type: grid
      measures:
        # Categorical: the archive declares the names and the extractor returns one, so
        # "it collided" and "it never arrived" occupy different cells instead of being
        # encoded into a number and decoded from a comment.
        failure_mode:  {values: [none, collision, timeout, goal_miss]}
        # RANGE FROM MEASUREMENT. `high: 1.5` is unreachable in this world by the
        # example's own arithmetic: the widest doorway is 1.6 m and nav2's robot_radius
        # 0.18, so search/nav_extract.py takes clearance_scale = 1.6/2 - 0.18 = 0.62 m
        # as the most clearance any configuration can offer. Measured over the 60 cells
        # of a full-budget Halton run, min_clearance spanned -0.089 .. 0.433 m and
        # touched 4 of these 10 bins.
        min_clearance: {low: -0.15, high: 0.5, bins: 10}
    sigma: 0.15
  search_space:
    gap_width:    {type: float, low: 0.4, high: 1.6}
    walker_dwell: {type: float, low: 0.0, high: 8.0}
  variations:
  - variations/doorway.py:DoorwayVariation:
      sim: {instances: components.barrier.instances}
      gap_width: $gap_width
  - ParameterVariationList:
      sim: components.pedestrian.dwell
      values: [$walker_dwell]
  postprocessing:
  # The bags have to be converted HERE, inside the loop: search.postprocessing runs before
  # each batch is scored, while results_processing runs once the campaign is over. Without
  # it the extractor reads a poses.csv that does not exist yet and refuses the batch.
  #
  # Written exactly as results_processing below, because it is now dispatched the same way:
  # the commands that need the campaign's own image go to an in-cluster conversion Job and
  # the rest run in the controller. Before that, everything ran in the controller and the
  # converters failed there, so the extractor refused every batch.
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, turtlebot4_base_link_gt]
  - rosbags_to_csv:
      topics: [/collision, /clearance]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree: {bt_xml: files/nav2_bt.xml}
  - search/nav_metrics.py:NavMetrics
  extract:
    plugin: search/nav_extract.py:NavExtract
    params: {aggregate: worst, timeout: 120.0}
  objectives:
  - {name: robustness, direction: minimize}
  per_batch: 8
  budget:
  # RUNS, like every other campaign here, and for the reason they all use it: wall-clock is
  # not a measure of compute on a shared lane. A `time:` budget spends whatever the cluster
  # happened to give this campaign while it was contended -- measured, the same 5400 s that
  # is ample on a quiet lane bought 63 runs against the sibling campaigns' 180-256, so the
  # archive was judged on a fraction of their simulator and its coverage criterion never had
  # the chance to fire.
  #
  # It is not batches, which is a separate point and the one the archive actually needs: an
  # archive fills for as long as it is given and has no meaningful "done" short of the budget
  # running out. `runs:` says that just as well as `time:` does, and says it reproducibly.
  - runs: 240
  stopping:
  # REACHABLE, and by some margin: measured across ~2900 runs, 16 of the 40 archive cells
  # have been occupied at least once (coverage 0.400), and a single uniform-random campaign
  # reached 14 of them (0.350) on its own. 0.25 is ten cells.
  #
  # What bounds the archive is structural rather than budgetary: `timeout` never occurs, so
  # ten cells are dead; a collision only lands in the three lowest clearance bins, and a
  # clean crossing only in the upper eight. Those bounds give the 16 above, and no budget
  # reaches the other 24.
  #
  # This criterion has never fired here, and that is a statement about the STRATEGY rather
  # than about the target. QD fills this archive worse than uniform sampling does -- 5 cells
  # against random's 14 -- and reaches fewer cells per run as well, which is what a mutation
  # step too small to leave the region around its elites looks like. `sigma` is the first
  # thing to raise if that is worth chasing; the criterion is not the thing to lower.
  - metric: {name: coverage, op: '>=', value: 0.25}
  seed: 1

visualization:
  results:
    explorer:
      notebooks:
      # One campaign view per strategy: four cells, one figure, and headline numbers
      # computed from the campaign rather than written into the prose -- so a notebook
      # cannot claim a finding its own data does not support.
      - Analysis:
          campaign: analysis/nav_search_qd.ipynb

execution:
  containers:
    # roqsim, from the deployment's project. Nothing here names an image: which registry it
    # comes from is ROBOVAST_PROJECT's business, and naming one pins the example to a site.
    simulation:
      backend: roqsim
      config: world/empty_room.yaml
      resources: {cpu: 2.0, cpu_limit: 4, memory: 640Mi}
    # The system under test, kept vanilla. No `system_packages`: the TB4 description this
    # needs is already in the image, and declaring it anyway is not free -- any package key
    # makes RoboVAST build a derived image, so it costs an apt cycle per campaign to install
    # what is there.
    sut:
      image: family:robovast
      resources: {cpu: 3, memory: 640Mi}
    scenario:
      resources: {cpu: 0.85, cpu_limit: 2, memory: 512Mi}
  # Measured per node rather than declared: the same trial costs ~1.6x more CPU on the
  # slowest machine of a mixed cluster than on the fastest, so one declared figure is right on
  # none of them. `resources` above then states where measuring STARTS -- what the probe and
  # every not-yet-measured node run at -- and the ceiling a measurement may not exceed, so it
  # has to sit ABOVE demand rather than at it: a container capped under what it wants throttles
  # against the cap, its probe is refused as having measured the ceiling instead of the demand,
  # and no node is calibrated at all. simulation is 2.0 for exactly that reason; probes measure
  # it between 0.5 and 1.1 cores depending on the node.
  sizing: calibrated
  mode: ros2
  # 8, not 3. A cell's outcome here is BIMODAL, not noisy-around-a-value: measured over 15
  # repeats of each of 16 cells, 14 of them produced both a clean crossing and a hard failure
  # from identical parameters, because lidar noise and the walker's timing decide whether the
  # encounter happens at all. A cell therefore has no single robustness, it has a probability
  # of failing, and `aggregate: worst` asks "can this cell fail?" -- a question answered by
  # sampling the bad mode at least once.
  #
  # At 3 repeats that question is close to a coin flip: a cell that fails a fifth of the time
  # is caught 49% of the time, so the score a search sees is decided by whether the bad mode
  # happened to be drawn rather than by where the cell is. Resampled from those 240 runs, the
  # standard deviation of worst-of-k is 0.343 at k=1, 0.288 at k=3, 0.178 at k=8, against an
  # objective spanning ~1.6 -- so three repeats buy almost nothing over one, and eight give a
  # search a gradient it can actually follow.
  #
  # The cost is cells: runs are reps x cells, so this trades 60 badly-measured cells for ~30
  # well-measured ones. For a search that has to RANK cells, that is the better half of the
  # trade. The coverage campaigns make the opposite one -- see nav_search_random.vast.
  runs: 8
  # Declared, unlike every other example in this repo. Without it `stalled` is null, no
  # verdict about a wedged run is possible, and `vast campaign wait` cannot exit on one.
  # The trial bounds itself at 120 s; this is the outer backstop for a run that wedges
  # before its own timeout arms.
  #
  # 600 and not 300 in a SEARCH: this is a no-progress deadline, and in a search loop a
  # batch is followed by an in-cluster bag conversion before anything is scored. Progress
  # legitimately pauses for the length of that Job, and at 300 the stall verdict fired
  # while it was working -- reporting a wedge that was not one. The batch-mode grid keeps
  # 300, because its conversion runs after the campaign rather than inside it.
  timeout: 600
  scenario_file: scenario_roqsim.osc
  run_files:
  # Per-extension rather than "files/*": that glob crosses '/', so it also sweeps
  # __pycache__/*.pyc -- and run_files are hashed into the config identity, so a stray
  # recompile perturbs it.
  - "files/*.yaml"
  - "files/*.pgm"
  - "files/*.xml"
  - "files/*.py"
  env:
  - PYTHONUNBUFFERED: "1"

results_processing:
  # nav2's own operating-rate metric, graded per run into the `run_health` table.
  # Declared rather than discovered: a health check that ran everywhere would grade
  # campaigns it knows nothing about -- this one finds no misses in a non-nav2 stack and
  # would write "ok" for every run of it, a clean bill for a stack that was never there.
  health_checks:
  - nav2_control_loop_rate
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require: [base_link, odom, turtlebot4_base_link_gt]
  - rosbags_to_csv:
      topics: [/collision, /clearance]
  - rosbags_nav2bt_to_csv
  - nav2_bt_tree: {bt_xml: files/nav2_bt.xml}
  - search/nav_metrics.py:NavMetrics
