version: 3
metadata:
  name: ros2_param
configuration:
- name: test-parameter
  parameters:
  - test_parameter_value: "YES"
execution:
  containers:
    scenario:
      resources:
        cpu: 1
  runs: 1
  env:
  - ENABLE_X11: "false"
  scenario_file: ros2_param.osc
  run_files:
  - "files/*.yaml"
  - "files/*.py"
