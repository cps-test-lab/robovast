import osc.helpers
import osc.ros

# Take off, fly a 2.4 m square at 1.2 m, return, land. The stabiliser (quadrotor_controller) runs
# inside the simulator, so there is no SUT container. Legs are fixed waits, not arrival checks: a
# drone that cannot hold altitude must fly the same schedule, or the cells are not comparable.

scenario test_scenario:
    timeout(90s)

    do serial:
        serial:
            timeout(60s)
            wait_for_topics(topics: ['/clock'])
            wait_for_data(topic_name: '/drone/odom', topic_type: 'nav_msgs.msg.Odometry')

        bag_record(['/clock', '/drone/odom'], use_sim_time: true)

        serial:
            log(msg: 'take off and settle on the pad')
            wait elapsed(6s)

            log(msg: 'leg 1 -> (1.2, 1.2)')
            topic_publish(
                topic_name: '/drone/cmd_pos',
                topic_type: 'geometry_msgs.msg.PoseStamped',
                value: '{\"header\": {\"frame_id\": \"map\"}, \"pose\": {\"position\": {\"x\": 1.2, \"y\": 1.2, \"z\": 1.2}, \"orientation\": {\"w\": 1.0}}}')
            wait elapsed(8s)

            log(msg: 'leg 2 -> (-1.2, 1.2)')
            topic_publish(
                topic_name: '/drone/cmd_pos',
                topic_type: 'geometry_msgs.msg.PoseStamped',
                value: '{\"header\": {\"frame_id\": \"map\"}, \"pose\": {\"position\": {\"x\": -1.2, \"y\": 1.2, \"z\": 1.2}, \"orientation\": {\"w\": 1.0}}}')
            wait elapsed(8s)

            log(msg: 'leg 3 -> (-1.2, -1.2)')
            topic_publish(
                topic_name: '/drone/cmd_pos',
                topic_type: 'geometry_msgs.msg.PoseStamped',
                value: '{\"header\": {\"frame_id\": \"map\"}, \"pose\": {\"position\": {\"x\": -1.2, \"y\": -1.2, \"z\": 1.2}, \"orientation\": {\"w\": 1.0}}}')
            wait elapsed(8s)

            log(msg: 'return over the pad')
            topic_publish(
                topic_name: '/drone/cmd_pos',
                topic_type: 'geometry_msgs.msg.PoseStamped',
                value: '{\"header\": {\"frame_id\": \"map\"}, \"pose\": {\"position\": {\"x\": 0.0, \"y\": 0.0, \"z\": 1.2}, \"orientation\": {\"w\": 1.0}}}')
            wait elapsed(8s)

            # No landing mode: descending onto the pad is the landing.
            log(msg: 'land on the pad')
            topic_publish(
                topic_name: '/drone/cmd_pos',
                topic_type: 'geometry_msgs.msg.PoseStamped',
                value: '{\"header\": {\"frame_id\": \"map\"}, \"pose\": {\"position\": {\"x\": 0.0, \"y\": 0.0, \"z\": 0.0}, \"orientation\": {\"w\": 1.0}}}')
            wait elapsed(8s)

            log(msg: 'trial complete')
