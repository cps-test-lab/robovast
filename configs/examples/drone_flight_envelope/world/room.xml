<!--
  The flight room: 6 x 6 m, 2.8 m to the ceiling, lit well enough to see a 0.1 m drone.

  Hand-written rather than the built-in `empty_room` because that one is a fixed 10 x 10 m with a
  single overhead light: at this scale the Crazyflie is a speck in a large dark hall, and the whole
  point of this example is that you can see what the wind is doing to it. Everything here is
  primitives and built-in textures -- no meshes, no external assets -- so the room travels with the
  example and anyone can read it.

  Frame: floor at z = 0, room centred on the origin, +x east. The flight course lives inside a
  2.4 x 2.4 m square, well clear of the walls.
-->
<mujoco model="flight_room">
  <visual>
    <!-- Softer, wider shadows than the default: hard shadows on flat primitives read as dirt. -->
    <quality shadowsize="8192" offsamples="8"/>
    <map znear="0.05" zfar="30" shadowclip="0.5" shadowscale="0.7"/>
    <headlight ambient="0.40 0.40 0.43" diffuse="0.0 0.0 0.0" specular="0.0 0.0 0.0"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="gradient"
             rgb1="0.62 0.70 0.80" rgb2="0.86 0.90 0.94" width="256" height="256"/>
    <!-- A light, low-contrast floor. A dark checker swallows both the drone and its shadow, and the
         shadow is what tells you the altitude at a glance. -->
    <texture name="floor_tex" type="2d" builtin="checker"
             rgb1="0.88 0.89 0.91" rgb2="0.74 0.76 0.79" width="512" height="512"/>
    <material name="floor_mat" texture="floor_tex" texrepeat="6 6" specular="0.0" shininess="0.0"
              reflectance="0.0"/>
    <material name="wall_mat" rgba="0.90 0.89 0.87 1" specular="0.05" shininess="0.05"/>
    <material name="trim_mat" rgba="0.55 0.57 0.60 1" specular="0.1" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- Directional lights, not point lights. Four overhead point sources put a bright pool in
         the middle of the floor where their cones overlap, which reads as a spotlight rather than a
         lit room and washes out the drone's shadow exactly where the drone spends its time.
         Directional light has no position and no falloff, so the floor is evenly lit edge to edge.
         One casts the shadow (a single crisp shadow is a depth cue; several is mud), the other two
         only fill. -->
    <light name="key"   directional="true" dir="-0.45 -0.35 -1"  diffuse="0.42 0.42 0.41" specular="0 0 0" castshadow="true"/>
    <light name="fill_a" directional="true" dir=" 0.55 -0.25 -1" diffuse="0.16 0.16 0.17" specular="0 0 0" castshadow="false"/>
    <light name="fill_b" directional="true" dir=" 0.10  0.60 -1" diffuse="0.13 0.13 0.14" specular="0 0 0" castshadow="false"/>

    <geom name="floor" type="plane" size="3.0 3.0 0.05" material="floor_mat"
          friction="1.0 0.005 0.0001"/>

    <!-- Walls: 2.8 m, thin, solid. The drone can hit them, which is the point when the wind wins. -->
    <geom name="wall_north" type="box" pos=" 0.0  3.0 1.4" size="3.05 0.05 1.4" material="wall_mat"/>
    <geom name="wall_south" type="box" pos=" 0.0 -3.0 1.4" size="3.05 0.05 1.4" material="wall_mat"/>
    <geom name="wall_east"  type="box" pos=" 3.0  0.0 1.4" size="0.05 3.05 1.4" material="wall_mat"/>
    <geom name="wall_west"  type="box" pos="-3.0  0.0 1.4" size="0.05 3.05 1.4" material="wall_mat"/>

    <!-- A skirting line, purely so the eye can find the floor/wall join and judge depth. -->
    <geom name="trim_north" type="box" pos=" 0.0  2.94 0.06" size="3.0 0.012 0.06" material="trim_mat" contype="0" conaffinity="0"/>
    <geom name="trim_south" type="box" pos=" 0.0 -2.94 0.06" size="3.0 0.012 0.06" material="trim_mat" contype="0" conaffinity="0"/>
    <geom name="trim_east"  type="box" pos=" 2.94  0.0 0.06" size="0.012 3.0 0.06" material="trim_mat" contype="0" conaffinity="0"/>
    <geom name="trim_west"  type="box" pos="-2.94  0.0 0.06" size="0.012 3.0 0.06" material="trim_mat" contype="0" conaffinity="0"/>

    <!-- A fixed cinematic camera, for `roqsim render --camera room`. The tracking free camera is
         what the run view uses; this one is here so a still or a clip can be framed identically
         across configurations, which a tracking camera cannot do. -->
    <camera name="room" pos="2.7 -2.7 2.3" xyaxes="0.7071 0.7071 -0.0000 -0.2279 0.2279 0.9466"/>
  </worldbody>
</mujoco>
