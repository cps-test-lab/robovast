version: 7
metadata:
  name: ur5e-pick-place
  title: "UR5e pick-and-place: how accurate does the reported box pose have to be?"
  description: |
    A UR5e with a Robotiq 2F-85 is bolted to a workbench. A 60 mm box sits in front of it and an
    open bin stands to one side. Each trial: read the box's pose from a simulated detector, plan
    with MoveIt 2, pick the box up, carry it across and drop it in the bin. In roqsim (MuJoCo),
    over ROS 2.

    The factor is `position_stddev` -- the noise on the reported box pose. The jaws open to about
    87 mm around a 60 mm box, so there is ~13 mm of clearance PER SIDE, and that is the entire
    error budget for detection plus IK plus execution. The widest level is expected to fail, which
    is the point: an example that only ever passes shows nothing about where the edge is.
  keywords: [robotics, manipulation, pick-and-place, moveit2, mujoco, roqsim, ur5e, robotiq,
             grasping, perception-noise]

configuration:
- name: noise  # a configuration name carries no underscores
  variations:
  # The noise is a property of the world, so it is a `sim:` override and needs no scenario parameter.
  # 0.0 is the control; only the across-jaw component spends the clearance, so the levels pass 13 mm.
  - ParameterVariationList:
      sim: components.ur5e.object_detector.position_stddev
      values: [0.0, 0.008, 0.016, 0.028]

execution:
  # The MoveIt description is derived from the world the simulator loads, so the two cannot drift.
  # The detector reports in the body `base`; `pinch` ends the chain at the grasp site, not the flange.
  generate:
  - shell:
      out: moveit/gen
      image: family:robovast-roqsim
      inputs: ["world"]  # the whole directory: the world spawns a prop that lives beside it
      command: >-
        bash -lc "source /ws/install/setup.bash &&
        roqsim export moveit --world {inputs[0]}/ur5e_pick_place.yaml --out {out}
        --name ur5e_2f85 --root-link base --tip-site pinch
        --manifest {out}/.generated.json --check"

  containers:
    simulation:
      backend: roqsim
      config: world/ur5e_pick_place.yaml
      resources:
        cpu: 1
        memory: 1Gi

    sut:  # move_group and robot_state_publisher
      image: family:robovast-roqsim  # MoveIt's servers ship in the roqsim member
      resources:
        cpu: 2  # absorbs move_group's planning bursts
        memory: 1Gi

    scenario:  # the default image: a MoveGroup client needs the messages, not the servers
      resources:
        cpu: 1
        memory: 512Mi

  mode: ros2
  runs: 5  # enough to separate failure rates, not only to confirm an outcome
  scenario_file: scenario.osc
  # Per-extension globs: `files/*` would sweep `__pycache__` into the configuration's identity.
  run_files:
  - "files/*.py"
  - "moveit/*.py"
  - "world/*.yaml"
  - "world/*.xml"
  - "moveit/gen/*.urdf"
  - "moveit/gen/*.srdf"
  - "moveit/gen/*.yaml"
  - "moveit/gen/meshes/*.stl"  # without them move_group plans through the bench
  timeout: 900  # move_group takes most of a minute to come up

recording:
  ros2:
    use_sim_time: true  # stamps the bag on the clock move_group plans on

# The box's trajectory, so a failure can be read; a run that recorded no box pose measured nothing.
results_processing:
  postprocessing:
  - rosbags_tf_to_csv:
      frames: all
      require: [graspable_box]

# The trial, move_group and the simulator share a timeline only in the merged log.
visualization:
  results:
    run_view:
      panels:
      - scenario_tree:
          title: Trial
          position: {anchor: top-left, width: 320, height: "calc(50% - 44px)"}
          minimizable: true
          source: {table: behaviors}
      - log:
          title: Trial, move_group and simulator
          position: {anchor: bottom, height: 240}
          minimizable: true
