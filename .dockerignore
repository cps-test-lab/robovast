# Docker build context = the repository root (the images need pyproject.toml,
# poetry.lock, README.md, src/ and frontend/ui/). Everything else is excluded so the
# context stays small — without this the daemon is sent multiple GB (venv, .git,
# frontend/ui/node_modules, results) on every build.

# Local environments / VCS
.git
.github
venv
.venv
.mypy_cache
.pytest_cache
**/__pycache__
**/*.pyc

# Web UI: sources are copied in and built inside the image; never ship the host's
# node_modules (platform-specific) or a stale dist.
frontend/ui/node_modules
frontend/ui/dist

# The same rule for robovast_nav's panel remote, which is built in its own stage. The dist
# is package data of robovast-nav, so a host-built copy would be silently packaged into the
# wheel; excluding it makes the in-image build the only source. (Docker matches these
# patterns against the whole context-relative path, not the basename -- the bare `dist`
# below covers only the repository root, which is why both of these are spelled out.)
src/robovast_nav/web/node_modules
src/robovast_nav/robovast_nav/web/dist

# Campaign outputs / generated artifacts
results
allure-report
allure-results
docs/_build
**/.cache
**/.robovast_*
*.tar.gz

# Python build artifacts (the image installs from source)
dist
build
*.egg-info
