# A version-4 campaign: a configuration's fixed values moved under `parameters:`, grouped by
# the channel they are written into, and presets became composable through `use:`.
#
# Declares the keys v4 CHANGED, so migrating a later campaign past this version meets a
# fixture that actually exercises the step rather than one that happens to be silent about
# everything it touched.
version: 4
metadata:
  name: historic-v4
  title: Nav2 controller comparison (archived, v4)
configuration_presets:
  # A preset carries the same body a configuration does, minus what belongs to one
  # configuration. Kept here so a later step meets the block rather than only the entries.
  slow-costmap:
    parameters:
      sut:
        nav2.local_costmap.local_costmap.ros__parameters.update_frequency: 2.0
configuration:
- name: baseline
  use: [slow-costmap]
  parameters:
    sim:
      overrides:
        plugins: {ceiling: {enabled: false}}
    sut:
      nav2.controller_server.ros__parameters.FollowPath.max_vel_x: 0.25
execution:
  containers:
    scenario:
      image: ghcr.io/cps-test-lab/robovast:latest
      resources:
        cpu: 1
        memory: 2Gi
  runs: 2
  # Packed, so a future step that reasons about per-run versus per-job budgets has a
  # fixture where the two genuinely differ.
  runs_per_job: 2
  timeout: 600
  shm_size: 512Mi
  scenario_file: scenario.osc
