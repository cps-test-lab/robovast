# RoboVAST configuration — copy to `.env` and edit.
#
#   cp .env.example .env
#
# `vast` reads `./.env` from the directory it runs in (current directory only, no
# walk-up), once per command. A real environment variable always wins over a line here.
#
# IMPORTANT: `vast cluster setup` reads these at setup time and bakes them into
# Kubernetes Secrets. Changing one later needs `vast cluster setup --force` to take
# effect — editing this file alone changes nothing about a running service.
#
# Everything here is OPTIONAL unless a section says otherwise. An unset value means the
# feature is simply unavailable, not broken.
#
# Access credentials belong in `vast login`, not here: that stores them per user in
# ~/.config/robovast/config.json, outside any repository. This file is git-ignored, but
# a token in a project directory is one `git add -A` from being published anyway.


# ── Access token ─────────────────────────────────────────────────────────────────────
# The shared secret every client authenticates with. Leave unset and `vast serve` mints
# a temporary one and prints a login URL carrying it; `vast cluster setup`
# generates one and preserves it across re-runs (`--rotate-token` issues a new one).
# Set it explicitly to choose the value yourself.
#ROBOVAST_AUTH_TOKEN=


# ── Container images ─────────────────────────────────────────────────────────────────
# Where RoboVAST's four images come from: robovast, robovast-roqsim, robovast-controller
# and robovast-sidecar. One knob moves the whole set — which member a container needs
# follows from its role, so it is never something you configure. Defaults to
# ghcr.io/cps-test-lab. See docs/images.rst.
#
# `make release-images PROJECT=docker.io/<ns> PUSH=1` publishes a set and prints these two.
#ROBOVAST_PROJECT=docker.io/<ns>
# The tag they are pulled at; defaults to `latest`, which floats. Publish an immutable set
# (`make release-images PROJECT=... TAG=$(date +%F) PUSH=1`) and name it here to pin a
# deployment — one tag covers the family, so a tag is what pins it, not four digests.
#ROBOVAST_PROJECT_TAG=
#
# These belong in ~/.config/robovast/env rather than here if they describe your machine
# rather than this one project: `vast` reads this file from the current directory ONLY, so a
# per-project .env is silently out of scope when you run `vast` from anywhere else.


# ── Object store: GCP only ───────────────────────────────────────────────────────────
# REQUIRED for the `gcp` cluster flavor, which does not create the bucket — make it
# yourself and grant the credential read/write on it. Either HMAC keys or a service
# account JSON. These can also be passed as `-o gcs_bucket=... -o gcs_access_key=...`.
#ROBOVAST_GCS_BUCKET=
#ROBOVAST_GCS_ACCESS_KEY=
#ROBOVAST_GCS_SECRET_KEY=
#ROBOVAST_GCS_KEY_FILE=
#ROBOVAST_GCS_KEY_JSON=


# ── Container registry ───────────────────────────────────────────────────────────────
# Nothing here is needed to BUILD. RoboVAST runs a registry in the service pod and
# publishes it on /v2 of the service's own hostname, so the build target is derived from
# --ingress-host rather than configured. (A service with no Ingress has no address a node
# could pull from, and `build:` projects are refused at submit saying so.)
#
# These are credentials for SOMEONE ELSE'S registry -- an image a .vast names in its
# `image:` field. Pull only; the in-pod registry is open and needs no push credential.
#ROBOVAST_REGISTRY_SERVER=            # host the credential is for
#ROBOVAST_REGISTRY_USERNAME=
#ROBOVAST_REGISTRY_PASSWORD=
#ROBOVAST_REGISTRY_PULL_SECRET=       # use an existing Secret instead of the above
#ROBOVAST_BASE_EXPERIMENT_IMAGE=      # default `build.base_image` for this cluster


# ── Result share ─────────────────────────────────────────────────────────────────────
# The external share: where `--upload-to-share` pushes the raw archive at campaign end,
# and what the `vast share` verbs talk to. Set ROBOVAST_SHARE_TYPE to one of gcs,
# webdav, nextcloud, sftp — then the variables for that provider. Setup FAILS LOUDLY if
# the type is set and its variables are not.
#
# These may be READ-ONLY credentials, and that is a supported way to be set up:
# `vast share list` and `vast share download` work with them, while `vast share upload`
# and `vast share remove` are refused by the share — which is what read-only means.
# `vast share export` / `import` are performed by the service with its own credentials
# and need nothing here.
#ROBOVAST_SHARE_TYPE=

# gcs
#ROBOVAST_GCS_BUCKET=                 # also used as the share bucket
#ROBOVAST_GCS_PREFIX=
#ROBOVAST_GCS_WORKERS=

# webdav  (NOT nextcloud — see below; nextcloud reads none of these)
#ROBOVAST_WEBDAV_URL=                 # the collection URL to upload into
#ROBOVAST_WEBDAV_USER=
#ROBOVAST_WEBDAV_PASSWORD=

# nextcloud  — a public share link carries its own token, so there is no user/password
#ROBOVAST_SHARE_URL=

# sftp
#ROBOVAST_SFTP_HOST=
#ROBOVAST_SFTP_PORT=
#ROBOVAST_SFTP_USER=
#ROBOVAST_SFTP_PASSWORD=              # or a key below
#ROBOVAST_SFTP_KEY_FILE=
#ROBOVAST_SFTP_KEY_PEM=
#ROBOVAST_SFTP_REMOTE_DIR=

# Local lane only: where `--upload-to-share` writes the tar.gz when there is no external
# share. Defaults to an `_archives/` sibling of the campaign directories.
#ROBOVAST_ARCHIVE_DIR=


# ── Notifications ────────────────────────────────────────────────────────────────────
# ntfy push when a campaign finishes. Silently inactive when unset.
#ROBOVAST_NTFY_TOPIC=
#ROBOVAST_NTFY_SERVER=
#ROBOVAST_NTFY_TOKEN=


# ── Private plugin repositories ──────────────────────────────────────────────────────
# Token for installing a `git+https` variation plugin from a private repo. Mounted into
# the service as a read-only file, never as an environment variable, so it is not
# inherited by the processes it launches. GITHUB_TOKEN / GH_TOKEN also work.
#ROBOVAST_GIT_TOKEN=


# ── Miscellaneous ────────────────────────────────────────────────────────────────────
#ROBOVAST_KUBE_CONNECT_TIMEOUT=10     # seconds before an unreachable cluster gives up
#ROBOVAST_EXTRA_HOST_ALIASES=         # host=ip,host=ip injected into pods' /etc/hosts
