# RoboVAST configuration — copy to `.env` and edit.
#
#   cp .env.example .env
#
# `vast` reads `./.env` from the directory it runs in (current directory only, no
# walk-up), once per command. A real environment variable always wins over a line here.
#
# IMPORTANT: `vast exec cluster setup` reads these at setup time and bakes them into
# Kubernetes Secrets. Changing one later needs `vast exec cluster setup --force` to take
# effect — editing this file alone changes nothing about a running service.
#
# Everything here is OPTIONAL unless a section says otherwise. An unset value means the
# feature is simply unavailable, not broken.
#
# Access credentials belong in `vast login`, not here: that stores them per user in
# ~/.config/robovast/config.json, outside any repository. This file is git-ignored, but
# a token in a project directory is one `git add -A` from being published anyway.


# ── Access token ─────────────────────────────────────────────────────────────────────
# The shared secret every client authenticates with. Leave unset and `vast serve` mints
# a temporary one and prints a login URL carrying it; `vast exec cluster setup`
# generates one and preserves it across re-runs (`--rotate-token` issues a new one).
# Set it explicitly to choose the value yourself.
#ROBOVAST_AUTH_TOKEN=


# ── Container images ─────────────────────────────────────────────────────────────────
# Override the published GHCR defaults — normally only to test an interim build.
# `make release-images PROJECT=docker.io/<ns> PUSH=1` prints these three as pinned
# digests and offers to write them here.
#ROBOVAST_IMAGE=
#ROBOVAST_CONTROLLER_IMAGE=
#ROBOVAST_ROBOSITO_IMAGE=
#ROBOVAST_SIDECAR_IMAGE=
# robosito's own simulator image (a different repository's artefact).
#ROBOSITO_IMAGE=


# ── Object store: GCP only ───────────────────────────────────────────────────────────
# REQUIRED for the `gcp` cluster flavor, which does not create the bucket — make it
# yourself and grant the credential read/write on it. Either HMAC keys or a service
# account JSON. These can also be passed as `-o gcs_bucket=... -o gcs_access_key=...`.
#ROBOVAST_GCS_BUCKET=
#ROBOVAST_GCS_ACCESS_KEY=
#ROBOVAST_GCS_SECRET_KEY=
#ROBOVAST_GCS_KEY_FILE=
#ROBOVAST_GCS_KEY_JSON=


# ── Container registry ───────────────────────────────────────────────────────────────
# Needed only for projects with a `build:` section (agent-built experiment images).
# Without a registry those campaigns are refused at submit; everything else works.
#ROBOVAST_REGISTRY_PREFIX=            # e.g. docker.io/<namespace> or a cluster registry
#ROBOVAST_REGISTRY_SERVER=            # host for the pull/push credential
#ROBOVAST_REGISTRY_USERNAME=
#ROBOVAST_REGISTRY_PASSWORD=
#ROBOVAST_REGISTRY_INSECURE=          # true for a plain-HTTP in-cluster registry
#ROBOVAST_REGISTRY_CA_FILE=           # private CA to trust, inlined into a ConfigMap
#ROBOVAST_REGISTRY_PUSH_SECRET=       # use an existing Secret instead of the above
#ROBOVAST_REGISTRY_PULL_SECRET=
#ROBOVAST_BASE_EXPERIMENT_IMAGE=      # default `build.base_image` for this cluster


# ── Result share ─────────────────────────────────────────────────────────────────────
# Where `--upload-to-share` pushes the raw, pre-postprocessing archive at campaign end.
# Set ROBOVAST_SHARE_TYPE to one of: gcs, webdav, nextcloud, sftp — then the variables
# for that provider. Setup FAILS LOUDLY if the type is set and its variables are not.
#ROBOVAST_SHARE_TYPE=

# gcs
#ROBOVAST_GCS_BUCKET=                 # also used as the share bucket
#ROBOVAST_GCS_PREFIX=
#ROBOVAST_GCS_WORKERS=

# webdav / nextcloud
#ROBOVAST_WEBDAV_URL=                 # the collection URL to upload into
#ROBOVAST_WEBDAV_USER=
#ROBOVAST_WEBDAV_PASSWORD=

# sftp
#ROBOVAST_SFTP_HOST=
#ROBOVAST_SFTP_PORT=
#ROBOVAST_SFTP_USER=
#ROBOVAST_SFTP_PASSWORD=              # or a key below
#ROBOVAST_SFTP_KEY_FILE=
#ROBOVAST_SFTP_KEY_PEM=
#ROBOVAST_SFTP_REMOTE_DIR=


# ── Notifications ────────────────────────────────────────────────────────────────────
# ntfy push when a campaign finishes. Silently inactive when unset.
#ROBOVAST_NTFY_TOPIC=
#ROBOVAST_NTFY_SERVER=
#ROBOVAST_NTFY_TOKEN=


# ── Private plugin repositories ──────────────────────────────────────────────────────
# Token for installing a `git+https` variation plugin from a private repo. Mounted into
# the service as a read-only file, never as an environment variable, so it is not
# inherited by the processes it launches. GITHUB_TOKEN / GH_TOKEN also work.
#ROBOVAST_GIT_TOKEN=


# ── Miscellaneous ────────────────────────────────────────────────────────────────────
#ROBOVAST_KUBE_CONNECT_TIMEOUT=10     # seconds before an unreachable cluster gives up
#ROBOVAST_EXTRA_HOST_ALIASES=         # host=ip,host=ip injected into pods' /etc/hosts
