{
  "name": "robovast-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RoboVAST web frontend \u2014 a thin client of robovast-service (RobovastInterface REST).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
