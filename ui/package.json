    "@mui/icons-material": "^6.1.0",
    "@mui/material": "^6.1.0",
    "@mui/x-data-grid": "^7.29.13",
    "@mui/x-tree-view": "^7.29.10",
    "@tanstack/react-query": "^5.59.0",
    "@types/three": "^0.185.1",
    "monaco-editor": "^0.52.0",
    "monaco-yaml": "^5.2.0",
    "plotly.js-dist-min": "^2.35.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "^2.6.0",
    "react-vega": "^7.7.1",
