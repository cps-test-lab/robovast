{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__.*__start_campaign",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/campaign_watch.py record",
            "statusMessage": "Noting the campaign to wait for"
          }
        ]
      },
      {
        "matcher": "mcp__.*__stop_campaign",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/campaign_watch.py clear",
            "statusMessage": "Clearing a settled campaign"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/campaign_watch.py delegated",
            "statusMessage": "Noting a backgrounded campaign waiter"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/campaign_watch.py check",
            "statusMessage": "Checking for a campaign still running"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/campaign_watch.py check",
            "statusMessage": "Checking for a campaign still running"
          }
        ]
      }
    ]
  }
}
